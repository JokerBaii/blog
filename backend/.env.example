# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BLOG_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
BLOG_BIND=127.0.0.1:8787
BLOG_MAX_UPLOAD_MB=25
# Default: backend/data.
# BLOG_DATA_DIR=/absolute/path/to/data
RUST_LOG=yuimi_blog_server=info,tower_http=info
