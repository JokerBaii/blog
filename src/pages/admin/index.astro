---
import SiteFonts from "@/core/SiteFonts.astro";
import { readSession } from "@/core/admin/session";
import PageContentEditor from "@/core/admin/PageContentEditor.astro";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
try {
  if (!(await readSession(Astro.cookies)).authenticated) return Astro.redirect(`/login/?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
} catch {
  return new Response("登录服务暂时不可用，请稍后刷新重试。", { status: 503, headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store", "Retry-After": "10" } });
}
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Frame-Options", "DENY");
import "@/core/admin/editor.css";
const tools = [
  { id: "writing", label: "写文章", path: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h6" },
  { id: "identity", label: "个人资料", path: "M20 21v-2a7 7 0 0 0-14 0v2 M13 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8" },
  { id: "projects", label: "作品卡片", path: "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" },
  { id: "links", label: "网站收藏", path: "M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2 M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2" },
  { id: "avatar", label: "我的头像", path: "M3 3h18v18H3z M3 16l5-5 5 5 4-4 4 4 M8 7h.01" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>写博客 | Jokerbai Lab</title>
    <script is:inline>
      try { document.documentElement.dataset.adminTheme = localStorage.getItem("yuimi-theme-id-v2") === "blank" ? "blank" : "manga"; } catch {}
    </script>
    <SiteFonts />
    <link rel="icon" href="/avatar.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="topbar"><a href="/" aria-label="返回 Jokerbai Lab 首页">Jokerbai <span>Lab</span></a><nav><a href="/blog/">阅读博客 ↗</a><button id="logout">退出登录</button></nav></header>
    <main>
      <p id="message" class="message" role="status" aria-live="polite"></p>
      <section id="workspace" class="workspace">
        <header class="desk-welcome"><div><p class="eyebrow">MY LITTLE NOTEBOOK / JOKERBAI LAB</p><h1>今天，也留下一点喜欢<span>。</span></h1><p>写下学会的、遇见的，还有舍不得忘掉的。</p></div><div class="desk-note"><span>DEAR ORDINARY DAYS</span><strong>今天的故事，<br />也值得被收藏。</strong><img src="/themes/fuyukawa-kagari/assets/manga/kagari-tea.webp" alt="" width="280" height="510" /></div></header>
        <aside class="desk-nav panel" aria-label="后台导航">
          <nav>
            {tools.map(tool => <button type="button" data-view={tool.id} aria-current={tool.id === "writing" ? "page" : undefined} aria-label={tool.label} title={tool.label}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={tool.path} /></svg><span>{tool.label}</span></button>)}
          </nav>
        </aside>
        <div class="desk-main">

          <div id="writing-view" class="writing-view">
            <aside class="library panel">
              <div class="section-head"><h2>我的文章</h2><button id="new-article" class="primary" type="button">＋ 新文章</button></div>
              <form id="search-form" class="search"><input id="search" type="search" placeholder="搜索文章（Ctrl P）" aria-label="搜索文章" /><button aria-label="搜索">⌕</button></form>
              <p id="list-state" class="hint"></p><div id="article-list" class="article-list"></div>
              <div class="pagination"><button id="previous" type="button" aria-label="上一页">←</button><span id="page-info"></span><button id="next" type="button" aria-label="下一页">→</button></div>
            </aside>
            <section class="editor panel">
              <div class="section-head editor-heading"><div><span id="article-status" class="status">新草稿</span><span id="save-state" class="hint"></span><a id="view-article" target="_blank" rel="noreferrer" hidden>查看文章 ↗</a></div><div class="actions article-actions"><button id="save-article" form="editor-form" class="primary" type="submit">保存草稿 ↗</button><label class="publish-control"><input id="published" form="editor-form" type="checkbox" role="switch" /><span class="switch-track"></span>公开发布</label><button id="delete-article" class="danger" type="button" hidden>删除</button></div></div>
              <form id="editor-form">
                <label class="sr-only" for="title">文章标题</label><input id="title" maxlength="200" required placeholder="给今天的故事起个名字…" />
                <div class="section-head body-heading"><div class="format-tools" aria-label="Markdown 格式"><button type="button" data-format="bold" title="加粗"><strong>B</strong></button><button type="button" data-format="italic" title="斜体"><em>I</em></button><button type="button" data-format="heading" title="二级标题">H₂</button><button type="button" data-format="link" title="插入链接">↗</button><button type="button" data-format="code" title="代码块">&lt;/&gt;</button><button id="attach-files" type="button" title="添加附件">＋ 附件</button></div><button id="preview-button" type="button" title="切换实时预览（Ctrl Shift V）" aria-expanded="true" aria-controls="preview-panel">◫ 实时预览 <kbd>Ctrl ⇧ V</kbd></button></div>
                <div id="editor-panes" class="editor-panes">
                  <div class="source-pane"><div class="pane-heading"><span>MARKDOWN</span><span>写下这一页</span></div><div id="markdown-editor"></div></div>
                  <section id="preview-panel" class="preview-panel" aria-label="实时预览"><div class="pane-heading"><span>PREVIEW · 同步滚动</span><button id="close-preview" type="button" aria-label="收起实时预览">×</button></div><iframe id="preview" title="文章正文预览" sandbox="allow-same-origin" referrerpolicy="no-referrer"></iframe><p id="preview-state" class="hint" role="status"></p></section>
                </div>
                <div class="editor-position"><span id="cursor-position">行 1，列 1</span><span id="word-count">0 字符</span><span>Markdown · Ctrl S 保存</span></div><textarea id="content" required rows="16" spellcheck="false" aria-label="Markdown 正文"></textarea>
                <button id="article-options-toggle" class="options-toggle" type="button" aria-expanded="false" aria-controls="article-options">文章设置 <span>分类、摘要与地址 ＋</span></button>
                <section id="article-options" hidden>
                  <fieldset class="category-options"><legend>分类</legend><label><input type="radio" name="article-category" value="tech" checked /><span>技术开发</span></label><label><input type="radio" name="article-category" value="anime" /><span>二次元</span></label><label><input type="radio" name="article-category" value="life" /><span>日常记录</span></label></fieldset>
                  <input id="category" type="hidden" value="tech" />
                  <label for="description">摘要</label><textarea id="description" maxlength="1000" rows="2" placeholder="用一两句话介绍这篇文章"></textarea>
                  <label for="tags">标签</label><input id="tags" placeholder="C++, 日常（逗号分隔）" />
                  <div class="section-head slug-heading"><label for="slug">文章地址 <span class="hint">自动生成</span></label><button id="custom-slug" type="button">自定义</button></div>
                  <p id="article-url" class="url-preview">保存后自动生成独立地址，同名文章也不会冲突。</p>
                  <input id="slug" hidden disabled maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="留空则自动生成" />
                </section>

              </form>
              <section class="attachments" aria-label="文章附件"><div class="section-head"><div><h3>随这一页，一起寄出</h3><p id="attachment-hint" class="hint">选择或拖入文件，链接会自动插入正文；保存或发布时一起提交。</p></div><label class="file-choice" for="upload-file"><span>＋ 添加附件</span><input id="upload-file" type="file" multiple /></label></div><p id="upload-filename" class="hint"></p><ul id="pending-attachments" aria-label="待提交附件"></ul><ul id="attachment-list" aria-label="已上传附件"></ul></section>
            </section>
          </div>
          <PageContentEditor />
          <section id="avatar-view" class="avatar-settings panel" hidden>
            <p class="eyebrow">A LITTLE PORTRAIT</p><h2>换个喜欢的头像</h2><p class="hint">会同步到两种主题的首页和 ME。</p>
            <img id="current-avatar" src="/api/avatar" alt="当前头像" width="120" height="120" />
            <form id="avatar-form"><div class="avatar-choices"><label class="file-choice" for="avatar-file"><span>↥ 上传图片</span><input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp" required /></label><button id="avatar-library" type="button">♡ 从图片库选择</button></div><p id="avatar-choice-state" class="hint">PNG / JPG / WebP · 最大 2 MB</p><button class="primary" type="submit">保存头像</button></form>
          </section>
        </div>
      </section>
      <dialog id="confirm-dialog" class="desk-dialog" aria-labelledby="confirm-title"><form method="dialog"><p class="eyebrow">A LITTLE REMINDER</p><h2 id="confirm-title">确认操作</h2><p id="confirm-text"></p><div class="actions"><button value="cancel" autofocus>再想想</button><button id="confirm-accept" class="danger" value="confirm">确定</button></div></form></dialog>
      <dialog id="image-dialog" class="desk-dialog image-dialog" aria-labelledby="image-title"><div class="section-head"><div><p class="eyebrow">PICK A LITTLE FRIEND</p><h2 id="image-title">贴纸与插画</h2></div><button id="image-close" type="button" aria-label="关闭图片库">×</button></div><p class="hint">选一张陪着这页笔记吧。透明立绘和原图都可以使用。</p><div id="image-filters" class="image-filters" aria-label="图片类型"></div><div id="image-grid" class="sticker-picker-grid"></div></dialog>
      <div class="editor-illustration" aria-hidden="true"><img src="/illustrations/cutouts/portrait-07.webp" alt="" width="753" height="1100" decoding="async" /></div>

    </main>
    <script>import "@/core/admin/editor";</script>
  </body>
</html>
