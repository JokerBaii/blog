---
import { Icon } from "astro-icon/components";
interface Props { tech: string; }
const { tech } = Astro.props;
const icons: Record<string, string> = {
  cpp: "simple-icons:cplusplus",
  algorithms: "tabler:code",
  cmake: "tabler:terminal-2",
  notes: "tabler:book-2"
};
const points = [
  [5, 8, 1.3], [10, 5, 1.2], [15, 6, 1.4], [19, 10, 1.2],
  [4, 14, 1.1], [9, 11, 1.5], [14, 12, 1.1], [18, 16, 1.4],
  [8, 18, 1.4], [13, 19, 1.1], [12, 15, 1.2], [20, 6, 0.7]
];
---
{tech === "cloud" ? (
  <svg xmlns="http://www.w3.org/2000/svg" width="1.35em" height="1.35em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="m5 8 5-3 5 1 4 4-1 6-5 3-5-1-4-4 1-6Zm5-3-1 6 5 1 5-2M4 14l5-3 3 4 6 1M8 18l4-3 1 4M15 6l-1 6-2 3" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.4" />
    {points.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
  </svg>
) : <Icon name={icons[tech] ?? "tabler:code"} aria-hidden="true" />}
