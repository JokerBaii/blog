---
import "./entry-gate.css";
interface Props { theme: "manga" | "blank"; standalone?: boolean; next?: string; }
const { theme, standalone = false, next } = Astro.props;
---
<dialog id="entry-gate" class="entry-gate" data-entry-theme={theme} data-standalone={standalone ? "true" : undefined} data-next={next} aria-labelledby="entry-title">
  <div class="entry-grain" aria-hidden="true"></div>
  <header class="entry-topline"><a href="/">Jokerbai Lab</a><span>A LITTLE WORLD / 01</span></header>
  <section id="entry-loading" class="entry-loading" aria-label="正在准备小站">
    <div class="entry-portal" aria-hidden="true"><i></i><i></i><i></i><svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="85" pathLength="100" /><path d="M82 60h36v55q0 30-27 30-16 0-24-11" /></svg><span>✦</span></div>
    <p class="entry-overline">CONNECTING OUR LITTLE WORLD</p><h1 id="entry-title">Jokerbai <em>Lab</em></h1><p class="entry-loading-copy">把散落的日常，拼成一个小小世界。</p>
    <div id="entry-progress" class="entry-progress" role="progressbar" aria-label="入站准备进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
    <div class="entry-progress-caption"><span id="entry-load-note">正在翻开这一页</span><span id="entry-percent">0%</span></div>
    <button id="entry-skip" class="entry-skip" type="button">先进去看看 →</button>
  </section>
  <section id="entry-welcome" class="entry-welcome" hidden aria-labelledby="entry-welcome-title">
    <div class="entry-picture" aria-hidden="true">
      <div class="entry-scene-heading"><p>こんに<br /><em>ちは。</em></p></div>
      <div class="entry-art-orbit"></div><span class="entry-hello">hello.</span><i class="entry-spark entry-spark-one">✦</i><i class="entry-spark entry-spark-two">✧</i>
      {theme === "manga" && <img src="/illustrations/cutouts/portrait-02.webp" alt="" width="753" height="1100" decoding="async" fetchpriority="high" />}
      <span class="entry-day-tag">今日份的小确幸 ♡</span>
      <div class="entry-postcard"><span>DEAR YOU,</span><p>日子慢慢过，<br />喜欢的人好好陪。</p><small>with love, jokerbai</small><b>♡</b></div>
    </div>
    <div class="entry-login">
      <div class="entry-letter-head"><span>JOKERBAI LAB / 001</span><span>✦ FOR YOU</span></div>
      <p class="entry-overline">YOU FOUND MY LITTLE WORLD</p><h2 id="entry-welcome-title">欢迎，<br />路过的你<span>。</span></h2><p class="entry-description">这里收藏代码、日常，<br />还有每一个不想忘记的瞬间。</p>
      <form id="entry-login-form"><label for="entry-username">站长账号</label><input id="entry-username" name="username" value="jokerbai" required autocomplete="username" maxlength="40" /><label for="entry-password">密码</label><input id="entry-password" name="password" type="password" required autocomplete="current-password" maxlength="128" /><button class="entry-primary" type="submit">进入小站 <span>↗</span></button></form>
      <a id="entry-author" class="entry-primary" href={next ?? "/admin/"} hidden>继续写作 <span>↗</span></a>
      <p id="entry-error" class="entry-error" role="alert"></p>
      <div class="entry-divider"><span>或是，随意逛逛</span></div><button id="entry-traveler" class="entry-traveler" type="button">以旅人身份进入 <span>→</span></button><p class="entry-traveler-note">不用账号，也能遇见这里的小日常。</p>
    </div>
  </section>
  <footer class="entry-bottomline"><span>NOTES · LIFE · LITTLE MOMENTS</span><span>MAKE YOURSELF AT HOME.</span></footer>
</dialog>
<script is:inline data-astro-rerun>
  (() => {
    const gate = document.getElementById("entry-gate");
    try {
      if (gate?.dataset.standalone === "true") gate.dataset.entryTheme = localStorage.getItem("yuimi-theme-id-v2") === "blank" ? "blank" : "manga";
      else if (sessionStorage.getItem("jokerbai-entry-admitted-v1")) return;
    } catch {}
    if (gate && !gate.open) gate.showModal();
  })();
</script>
<script>import "./entry-gate";</script>
