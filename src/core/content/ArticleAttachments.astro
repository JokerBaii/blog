---
import type { Attachment } from "./blog";
const { attachments = [], contentHtml = "" } = Astro.props as { attachments: Attachment[]; contentHtml?: string };
// Inspect rendered anchors so reference links and HTML links count, but code examples don't.
const linkedPaths = new Set<string>();
for (const [, href] of contentHtml.matchAll(/<a\b[^>]*\shref="([^"]*)"/gi)) {
  try {
    const url = new URL(href, Astro.url);
    if (url.origin === Astro.url.origin) linkedPaths.add(decodeURIComponent(url.pathname));
  } catch { /* Invalid links do not hide downloadable files. */ }
}
const remaining = attachments.filter(attachment => !linkedPaths.has(`/api/attachments/${attachment.id}/download`));
const sizeLabel = (size: number) => size < 1024 ? `${size} B` : size < 1024 ** 2 ? `${(size / 1024).toFixed(1)} KB` : `${(size / 1024 ** 2).toFixed(1)} MB`;
---
{remaining.length > 0 && (
  <section aria-label="文章附件" data-article-attachments>
    <h2 id="article-attachments">附件下载</h2>
    <ul>{remaining.map((attachment) => (
      <li><a href={`/api/attachments/${encodeURIComponent(attachment.id)}/download`} download={attachment.filename}>{attachment.filename}</a>（{sizeLabel(attachment.size)}）</li>
    ))}</ul>
  </section>
)}
