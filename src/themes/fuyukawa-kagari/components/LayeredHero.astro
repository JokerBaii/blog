---
import { mangaArt } from "../data/mangaArt";
---
<div class="manga-scene" data-manga-scene aria-hidden="true">
  <div class="manga-scene-camera">
    <img {...mangaArt("hero-manga")} class="manga-scene-back" data-manga-back alt="" decoding="async" draggable="false" />
    <img {...mangaArt("hero-character")} class="manga-scene-front" data-manga-front alt="" decoding="async" fetchpriority="high" draggable="false" />
  </div>
</div>
