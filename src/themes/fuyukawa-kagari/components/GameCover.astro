---
interface Props { game: "2048" | "hextris" | "clumsy-bird"; }
const { game } = Astro.props;
const tiles = [2, 4, 8, 0, 4, 16, 32, 2, 0, 64, 128, 4, 2, 8, 256, 0];
const colors: Record<number, string> = {
  0: "#d0e5da", 2: "#ffffff", 4: "#f3fbf6", 8: "#b5ddca",
  16: "#91cbb4", 32: "#67b498", 64: "#459c81", 128: "#33826e", 256: "#286a5b"
};
---
<svg class="game-cover-art" viewBox="0 0 360 220" fill="none" aria-hidden="true">
  {game === "2048" ? (
    <>
      <rect width="360" height="220" fill="#e2f4eb" />
      <path d="M0 180H360M40 0V220M320 0V220" stroke="#cae5d9" />
      <rect x="86" y="6" width="188" height="208" rx="8" fill="#fafefb" />
      <text x="98" y="31" fill="#3a7b65" font-size="15" font-weight="700" font-family="system-ui, sans-serif">2048</text>
      <text x="262" y="30" text-anchor="end" fill="#618e7b" font-size="9" font-family="system-ui, sans-serif">JOIN THE NUMBERS</text>
      {tiles.map((value, index) => (
        <g transform={`translate(${98 + index % 4 * 42}, ${43 + Math.floor(index / 4) * 40})`}>
          <rect width="38" height="36" rx="4" fill={colors[value]} />
          {value > 0 && <text x="19" y="24" text-anchor="middle" font-size={value >= 100 ? "14" : "18"} font-weight="700" font-family="system-ui, sans-serif" fill={value >= 32 ? "#ffffff" : "#3e725f"}>{value}</text>}
        </g>
      ))}
    </>
  ) : game === "hextris" ? (
    <>
      <rect width="360" height="220" fill="#e5f2fa" />
      <g transform="translate(180 116)">
        <path d="M0-96 83-48 83 48 0 96-83 48-83-48Z" stroke="#c5dfec" />
        <path d="M0-68 59-34 59 34 0 68-59 34-59-34Z" stroke="#c5dfec" />
        <path d="M0-40 35-20 35 20 0 40-35 20-35-20Z" fill="#527f97" />
        <path d="M-37-27 0-48 37-27" stroke="#83c8b0" stroke-width="10" stroke-linejoin="round" />
        <path d="M44-21V25L7 46" stroke="#e6a2b9" stroke-width="10" stroke-linejoin="round" />
        <path d="M-44-21V25L-7 46" stroke="#84badb" stroke-width="10" stroke-linejoin="round" />
        <path d="M54-28V32" stroke="#a9a1cd" stroke-width="9" />
        <path d="M-63-34V36" stroke="#e6c779" stroke-width="9" />
        <text y="5" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="11" fill="white">HEXTRIS</text>
      </g>
      <path d="M36 75V118M304 124V167M162 14 201 36" stroke="#84badb" stroke-width="8" />
    </>
  ) : (
    <>
      <rect width="360" height="220" fill="#f9edf3" />
      <path d="M0 191H360V220H0Z" fill="#d4e9d7" />
      <path d="M0 191H360" stroke="#99c3a2" stroke-width="5" />
      <path d="M0 215H360M12 202H60M100 202H155M210 202H266M300 202H345" stroke="#bddac2" stroke-width="4" />
      <path d="M44 0H78V76H44Z M38 67H84V82H38Z M276 133H310V191H276Z M270 125H316V142H270Z" fill="#90bba5" stroke="#5f987e" stroke-width="3" />
      <path d="M49 0V64M282 146V187" stroke="#c9e4d4" stroke-width="5" />
      <path d="M114 43H134V32H159V38H176V47H114Z M214 71H232V58H250V65H267V76H214Z" fill="white" />
      <g transform="translate(150 98)">
        <path d="M0 0H31V7H39V31H30V38H0V31H-8V8H0Z" fill="#e8b7cc" stroke="#aa6689" stroke-width="3" />
        <path d="M-7 17H11V29H-7Z" fill="#fcdeea" stroke="#aa6689" stroke-width="3" />
        <path d="M22 5H34V19H22Z" fill="white" />
        <path d="M29 8H34V16H29Z" fill="#474754" />
        <path d="M28 22H47V29H28Z" fill="#e4b774" stroke="#aa6689" stroke-width="2" />
      </g>
      <text x="180" y="177" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#aa6689">CLUMSY BIRD</text>
    </>
  )}
</svg>
