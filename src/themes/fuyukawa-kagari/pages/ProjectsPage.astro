---
import TechIcon from "@/core/TechIcon.astro";
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { projectTechLines as techLines } from "@/core/data/projects";
import { getPageContent } from "@/core/data/page-content";
const { projects: projectEntries } = await getPageContent();
import { getPublishedPosts } from "@/core/content/blog";
import { getThemePath } from "@/core/themes/registry";
import "../styles/works-scrapbook.css";

const projectPresentation = {
  "cpp-notes": { accent: "mint", note: "one small step ♡" },
  "cloud-lab": { accent: "blue", note: "connect the dots" },
  "algorithm-notes": { accent: "orange", note: "take your time" },
  "build-notes": { accent: "ink", note: "it works, yay!" },
  "campus-notes": { accent: "pink", note: "little moments ♡" },
  "blog-lab": { accent: "lavender", note: "made with love" }
} as const;
const projectCards = projectEntries.map((project) => ({
  ...project,
  ...projectPresentation[project.id]
}));
const campusPosts = (await getPublishedPosts()).filter((post) => post.data.tags.includes("下课后的随手记"));

---

<BaseLayout title="Projects | Jokerbai Lab" description="jokerbai 的 C++、点云与个人学习笔记。">
  <section class="works-shell works-scrapbook" aria-labelledby="works-title">
    <PageIntro image="projects" title="灵感工坊" subtitle="Made of little ideas." titleId="works-title" />

    <div class="works-filter" data-works-filter aria-label="Project filters">
      <button type="button" class="is-active" data-filter="all" aria-pressed="true">全部</button>
      {techLines.map((item) => (
        <button type="button" data-filter={item.key} aria-pressed="false">
          <TechIcon tech={item.key} />
          {item.label}
        </button>
      ))}
    </div>

    <section class="works-tech-board" aria-label="Tech lines">
      {techLines.map((item) => (
        <article data-line-card={item.key}>
          <TechIcon tech={item.key} />
          <strong>{item.label}</strong>
          <span>{item.note}</span>
        </article>
      ))}
    </section>

    <header class="works-collection-heading">
      <div><p>MY LITTLE COLLECTION</p><h2>把小想法，慢慢养大<span aria-hidden="true"> ♡</span></h2></div>
      <span class="works-collection-count">{String(projectCards.length).padStart(2, "0")} 份小小的尝试</span>
    </header>
    <section class="works-grid" aria-label="Project cards">
      {projectCards.map((project, index) => (
        <article class={`works-card works-card--${project.accent}`} data-project-line={project.line}>
          <span class="works-page-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div class="works-card-head">
            <span class="works-card-icon" aria-hidden="true">
              <TechIcon tech={project.line} />
            </span>
            <div>
              <p>{project.type}</p>
              <h2>{project.title}</h2>
            </div>
          </div>
          <p class="works-card-summary">{project.summary}</p>
          <div class="works-card-tags">
            {project.details.map((detail) => (
              <span>{detail}</span>
            ))}
          </div>
          <footer class="works-card-footer">
            <button type="button" class="works-card-toggle" data-card-toggle aria-expanded="false" aria-controls={`project-status-${project.id}`}>
              <Icon name="tabler:book-2" aria-hidden="true" />
              <span>翻开这一页</span>
              <Icon name="tabler:chevron-down" aria-hidden="true" />
            </button>
            <span class="works-card-handwriting">{project.note}</span>
            <img src={project.sticker} class="works-card-sticker" data-art-kind={project.sticker.startsWith("/illustrations/") ? "portrait" : "chibi"} alt="" width="72" height="72" loading="lazy" decoding="async" />
          </footer>
          <div class="works-card-panel" id={`project-status-${project.id}`} data-card-panel hidden>
            <strong>{project.id === "campus-notes" && campusPosts.length ? `已经夹好 ${campusPosts.length} 篇课后笔记` : project.status}</strong>
            {project.id === "campus-notes" && campusPosts.length ? (
              <ul class="works-note-links">
                {campusPosts.map((post) => (
                  <li><a href={getThemePath("fuyukawa-kagari", `/blog/${post.id}/`)}>{post.data.title}<span aria-hidden="true"> ↗</span></a></li>
                ))}
              </ul>
            ) : <p>下一步会把相关笔记、截图或可玩的 demo 慢慢补到这里。</p>}
          </div>
        </article>
      ))}
    </section>

    <p class="works-art-credit">贴纸：Blue Archive · NEXON Games · <a href="https://forum.nexon.com/bluearchive/board_view?board=1044&amp;thread=1881343" target="_blank" rel="noopener noreferrer">官方数字周边</a></p>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
    const filterRoot = document.querySelector("[data-works-filter]");
    const filterButtons = filterRoot ? Array.from(filterRoot.querySelectorAll("button")) : [];
    const cards = Array.from(document.querySelectorAll("[data-project-line]"));
    const lineCards = Array.from(document.querySelectorAll("[data-line-card]"));

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "all";

        filterButtons.forEach((item) => {
          item.classList.toggle("is-active", item === button);
          item.setAttribute("aria-pressed", String(item === button));
        });
        cards.forEach((card) => {
          const isMatch = filter === "all" || card.dataset.projectLine === filter;
          card.classList.toggle("is-dimmed", !isMatch);
          card.hidden = !isMatch;
        });
        lineCards.forEach((card) => {
          const isMatch = filter === "all" || card.dataset.lineCard === filter;
          card.classList.toggle("is-highlighted", isMatch && filter !== "all");
        });
      });
    });

    document.querySelectorAll("[data-card-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const card = button.closest(".works-card");
        if (!card) return;

        const isOpen = card.classList.toggle("is-open");
        button.setAttribute("aria-expanded", String(isOpen));
        const label = button.querySelector("span");
        if (label) label.textContent = isOpen ? "先夹好书签" : "翻开这一页";
        const panel = card.querySelector("[data-card-panel]");
        if (panel) panel.hidden = !isOpen;
      });
    });
    })();
  </script>

  <style>
    .works-shell {
      margin: 0 auto;
      display: grid;
    }

    :global(.waifu-local-fallback) {
      left: 6px !important;
      width: 112px !important;
      opacity: 0.72 !important;
    }

    :global(.waifu-local-bubble) {
      display: none !important;
    }

    :global(.waifu-local-character) {
      width: 92px !important;
      height: 92px !important;
      margin-left: 0 !important;
    }

    :global(.waifu-local-character img) {
      width: 72px !important;
      height: 72px !important;
    }

    .works-filter,
.works-tech-board {
      position: relative;
      isolation: isolate;
      overflow: visible;
      -webkit-backdrop-filter: blur(2px) saturate(1.03);
    }

    .works-card {
      position: relative;
      isolation: isolate;
      overflow: visible;
      border-radius: 8px;
      -webkit-backdrop-filter: blur(2px) saturate(1.03);
    }

    .works-card-icon svg,
    .works-tech-board svg {
      width: 1.35em;
      height: 1.35em;
    }

    .works-filter {
      display: flex;
      flex-wrap: wrap;
    }

    .works-filter button,
.works-card-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      color: var(--ink);
      font: inherit;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .works-filter button:hover,
    .works-card-toggle:hover {
      transform: translateY(-2px);
      box-shadow: var(--paper-shadow);
    }

    .works-tech-board {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .works-tech-board article {
      display: grid;
      gap: 8px;
      color: var(--ink);
      transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
    }

    .works-tech-board strong {
      color: var(--ink);
    }

    .works-tech-board span {
      color: var(--ink-soft);
      line-height: 1.55;
    }

    .works-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .works-card {
      display: grid;
      align-content: start;
      transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
    }

    .works-card.is-dimmed {
      opacity: 0.38;
      transform: scale(0.98);
    }

    .works-card-head {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .works-card-icon {
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      width: 48px;
      height: 48px;
      color: var(--ink);
      background: var(--blue-soft);
      border-radius: 8px;
    }

    .works-card--orange .works-card-icon { color: #e2762d; background: #ffe8cf; }
    .works-card--ink .works-card-icon { color: #fffaf1; background: #31425f; }
    .works-card--pink .works-card-icon { color: #c85278; background: var(--pink-soft); }
    .works-card--mint .works-card-icon { color: #3c8067; background: rgba(184, 219, 201, 0.58); }
    .works-card--lavender .works-card-icon { color: #6d63a8; background: rgba(201, 194, 238, 0.52); }

    .works-card-head p {
      margin: 0;
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-weight: 850;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .works-card h2 {
      margin: 4px 0 0;
      color: var(--ink);
      line-height: 1.32;
      letter-spacing: 0;
    }

    .works-card-summary,
    .works-card-panel p {
      margin: 0;
      color: var(--ink-soft);
      line-height: 1.78;
    }

    .works-card-tags {
      display: flex;
      flex-wrap: wrap;
    }

    .works-card-tags span {
      font-weight: 800;
    }

    .works-card-toggle {
      justify-self: start;
      margin-top: auto;
    }

    .works-card-toggle svg {
      transition: transform 180ms ease;
    }

    .works-card.is-open .works-card-toggle svg {
      transform: rotate(180deg);
    }

    .works-card[hidden],
    .works-card-panel[hidden] {
      display: none;
    }

    .works-card-panel {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows 220ms ease, opacity 180ms ease;
    }

    .works-card-panel > * {
      overflow: hidden;
    }

    .works-card.is-open .works-card-panel {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    @media (max-width: 1080px) {
      .works-tech-board,
.works-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 720px) {

      .works-tech-board,
.works-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
