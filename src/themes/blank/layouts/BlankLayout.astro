---
import "../styles/theme.css";
import { Icon } from "astro-icon/components";
import type { BlogPost } from "@/core/content/blog";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import SeoMeta from "@/core/SeoMeta.astro";
import { getCanonicalPath, getThemePath, themes } from "@/core/themes/registry";
import { profileIdentity } from "@/core/data/profile";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  isArticlePage?: boolean;
  article?: BlogPost["data"];
}

const { title = "Yuimi Lab | Blank", description = site.description, isArticlePage = false, article } = Astro.props;
const canonicalPath = getCanonicalPath(Astro.url.pathname);
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
const navItems = site.nav.map((item, index) => ({
  ...item,
  number: String(index + 1).padStart(2, "0"),
  active: item.href === "/" ? canonicalPath === "/" : canonicalPath.startsWith(item.href),
  href: getThemePath("blank", item.href)
}));
---

<!doctype html>
<html lang="zh-CN" data-theme="blank">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PerformanceProfile />
    <SeoMeta title={title} description={description} canonical={canonical} isArticlePage={isArticlePage} article={article} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <ThemePreferenceGate currentTheme="blank" />
    <ConsoleEasterEgg />
    <title>{title}</title>
  </head>
  <body data-blank data-pagefind-ignore data-yuimi-article-page={isArticlePage ? "true" : undefined}>
    <a class="blank-skip-link" href="#blank-main">跳到正文</a>
    <header class="blank-header">
      <div class="blank-header-inner">
        <a class="blank-wordmark" href={getThemePath("blank", "/")} aria-label="Yuimi Lab 首页">
          <strong>yuimi<span aria-hidden="true">.</span></strong>
          <span class="blank-edition">BLANK / 02</span>
        </a>
        <nav class="blank-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              <span class="blank-nav-number" aria-hidden="true">{item.number}</span>{item.label}
            </a>
          ))}
        </nav>
        <button class="blank-icon-button blank-theme-trigger" type="button" data-blank-menu-trigger hidden
          aria-controls="blank-theme-menu" aria-expanded="false" aria-label="切换主题" title="切换主题">
          <Icon name="tabler:palette" size={19} />
          <span class="blank-tooltip" aria-hidden="true">切换主题</span>
        </button>
      </div>
      {isArticlePage && <div class="blank-reading-track" aria-hidden="true"><span data-blank-progress></span></div>}
    </header>

    <main id="blank-main" class:list={["blank-main", { "blank-main--article": isArticlePage }]} tabindex="-1">
      <slot />
    </main>

    <footer class="blank-footer">
      <div class="blank-footer-top">
        <a class="blank-footer-brand" href={getThemePath("blank", "/")}>Yuimi Lab<span aria-hidden="true">.</span></a>
        <div class="blank-footer-links">
          <a href={profileIdentity.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="tabler:external-link" size={14} /></a>
          <a href={profileIdentity.bilibili} target="_blank" rel="noopener noreferrer">Bilibili <Icon name="tabler:external-link" size={14} /></a>
          <a href={getThemePath("blank", "/about/")}>关于我 <Icon name="tabler:arrow-right" size={15} /></a>
        </div>
      </div>
      <div class="blank-footer-bottom">
        <span>© 2026 喝益胃 / Yuimi-chaya</span>
        <span>记录、创造，以及生活。</span>
        <a href="#blank-main" class="blank-back-top">回到顶部 <Icon name="tabler:arrow-up" size={14} /></a>
      </div>
      <noscript>
        <div class="blank-noscript-themes">
          {themes.map((theme) => <a href={getThemePath(theme.id, canonicalPath)}>{theme.label}</a>)}
        </div>
      </noscript>
    </footer>

    <nav id="blank-theme-menu" class="blank-context-menu" data-blank-context-menu hidden aria-label="主题与页面">
      <p class="blank-kicker">APPEARANCE / 主题</p>
      {themes.map((theme, index) => (
        <button type="button" data-theme-select={theme.id} aria-pressed={theme.id === "blank"}>
          <span class="blank-menu-index">{String(index + 1).padStart(2, "0")}</span>
          <span>{theme.label}</span>
          {theme.id === "blank" && <span class="blank-menu-current" aria-hidden="true"></span>}
        </button>
      ))}
      <hr />
      <a href={getThemePath("blank", "/")}><Icon name="tabler:home" size={17} />返回首页</a>
      <a href="#blank-main"><Icon name="tabler:arrow-up" size={17} />回到顶部</a>
    </nav>
    <ThemeLongPressMenu />
    <script>
      import { mountBlank } from "../lib/runtime.mjs";
      mountBlank(document, window);
    </script>
  </body>
</html>
