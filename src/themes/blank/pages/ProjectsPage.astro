---
import { Icon } from "astro-icon/components";
import BlankLayout from "../layouts/BlankLayout.astro";
import PageHead from "../components/PageHead.astro";
import { projectEntries, projectTechLines } from "@/core/data/projects";
---
<BlankLayout title="Works | Yuimi Lab Blank" description="游戏、建模、插件与网页。一些持续进行的小实验。">
  <PageHead index="02" title="Works" label="实践与项目" description="把兴趣落到实处。在反复试验里，慢慢接近想象中的样子。" count={String(projectEntries.length).padStart(2, "0")} unit="个项目" />
  <section class="blank-projects" data-blank-collection data-unit="个项目" aria-label="项目目录">
    <form class="blank-filter-form" data-blank-filter-form hidden>
      <fieldset class="blank-filters">
        <legend class="blank-sr-only">项目技术分类</legend>
        <button type="button" data-blank-category="all" aria-pressed="true">全部项目</button>
        {projectTechLines.map((line) => <button type="button" data-blank-category={line.key} aria-pressed="false">{line.label}</button>)}
      </fieldset>
    </form>
    <div class="blank-list-heading"><span class="blank-kicker">PROJECT INDEX</span><output data-blank-count aria-live="polite" aria-atomic="true">{projectEntries.length} 个项目</output></div>
    <div class="blank-project-list" data-blank-entries>
      {projectEntries.map((project, index) => (
        <details id={project.id} class="blank-project" open={index === 0} data-blank-entry data-category={project.line}>
          <summary>
            <span class="blank-row-number">{String(index + 1).padStart(2, "0")}</span>
            <div class="blank-project-name"><span class="blank-kicker">{project.type}</span><h2>{project.title}</h2></div>
            <span class="blank-project-status">{project.status}</span>
            <Icon class="blank-disclosure-icon" name="tabler:arrow-down" size={21} />
          </summary>
          <div class="blank-project-body"><p>{project.summary}</p><ul>{project.details.map((detail) => <li>{detail}</li>)}</ul></div>
        </details>
      ))}
    </div>
    <div class="blank-empty-results" data-blank-empty hidden><p>这个分类暂时没有项目。</p><button class="blank-text-link" type="button" data-blank-reset>查看全部 <Icon name="tabler:arrow-right" size={17} /></button></div>
  </section>
  <section class="blank-section">
    <div class="blank-section-heading"><div><p class="blank-kicker">TOOLKIT / 技术线</p><h2>常用工具</h2></div></div>
    <dl class="blank-toolkit">{projectTechLines.map((line) => <div><dt>{line.label}</dt><dd>{line.note}</dd></div>)}</dl>
  </section>
</BlankLayout>
