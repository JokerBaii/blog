---
import { Icon } from "astro-icon/components";
import BlankLayout from "../layouts/BlankLayout.astro";
import PageHead from "../components/PageHead.astro";
import { animeFavorites, currentSignals, favoriteGames, profileIdentity, profileStatus, profileTech, xpFavorites } from "@/core/data/profile";
---
<BlankLayout title="About | Yuimi Lab Blank" description="关于喝益胃 / Yuimi-chaya。兴趣、近况，与一些喜欢的事。">
  <PageHead index="04" title="About" label="关于我" description="一个兴趣驱动的人，一份仍在续写的自我介绍。" />
  <section class="blank-profile">
    <div class="blank-profile-name"><p class="blank-kicker">{profileIdentity.handle}</p><h2>{profileIdentity.displayName}<span aria-hidden="true">。</span></h2><p>DEVELOPER / HOBBYIST</p></div>
    <div class="blank-profile-bio">
      <p class="blank-profile-lead">{profileIdentity.bio}</p>
      <ul class="blank-status-list">{profileStatus.map((item) => <li>{item}</li>)}</ul>
      <div class="blank-contact-links">
        <a class="blank-text-link" href={profileIdentity.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="tabler:external-link" size={17} /></a>
        <a class="blank-text-link" href={profileIdentity.bilibili} target="_blank" rel="noopener noreferrer">Bilibili <Icon name="tabler:external-link" size={17} /></a>
      </div>
    </div>
  </section>
  <section class="blank-section blank-about-section">
    <div><p class="blank-kicker">01 / PRACTICE</p><h2>在做的事</h2></div>
    <dl class="blank-tech-list">{profileTech.map((item, index) => <div><dt><span class="blank-row-number">{String(index + 1).padStart(2, "0")}</span>{item.name}</dt><dd>{item.note}</dd></div>)}</dl>
  </section>
  <section class="blank-section blank-about-section">
    <div><p class="blank-kicker">02 / FAVORITES</p><h2>喜欢的作品</h2></div>
    <div class="blank-favorites">
      <h3 class="blank-kicker">ANIMATION / 动画</h3>
      <ol class="blank-favorites-list">{animeFavorites.map((item, index) => <li><span class="blank-row-number">{String(index + 1).padStart(2, "0")}</span><div><strong>{item.title}</strong><span>{item.subtitle}</span></div></li>)}</ol>
      <h3 class="blank-kicker">GAMES / 游戏</h3>
      <ul class="blank-favorite-games">{favoriteGames.map((item) => <li><strong>{item.title}</strong><span>{item.subtitle}</span></li>)}</ul>
      <h3 class="blank-kicker">PREFERENCES / 偏好</h3>
      <ul class="blank-preferences">{xpFavorites.map((item) => <li>{item.title}</li>)}</ul>
    </div>
  </section>
  <section class="blank-section blank-about-section">
    <div><p class="blank-kicker">03 / NOW</p><h2>最近的状态</h2></div>
    <dl class="blank-signals">{currentSignals.map((item) => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
  </section>
</BlankLayout>
